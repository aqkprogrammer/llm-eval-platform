# ---------------------------------------------------------------------------------------------
# LLM Eval Platform configuration. Copy to `.env` and adjust. Everything works offline with the
# defaults (mock providers + SQLite); add API keys to evaluate real models.
# ---------------------------------------------------------------------------------------------

# General
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console            # console | json
CORS_ORIGINS=["*"]

# Database: SQLite for local dev, PostgreSQL in Docker/production
DATABASE_URL=sqlite+aiosqlite:///./evalplatform.db
# DATABASE_URL=postgresql+asyncpg://eval:eval@localhost:5432/evalplatform
AUTO_CREATE_TABLES=true       # set false when managing the schema with Alembic

# Providers (mock is always available)
DEFAULT_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_BASE_URL=              # optional, for OpenAI-compatible endpoints
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1
PROVIDER_TIMEOUT_S=60
MOCK_LATENCY_SCALE=1.0        # 0 disables simulated latency

# LLM-as-judge (correctness, safety_judge, faithfulness mode=llm)
JUDGE_PROVIDER=mock           # mock | anthropic | openai | ollama
JUDGE_MODEL=mock-judge        # e.g. claude-sonnet-5

# Semantic similarity embeddings
EMBEDDING_PROVIDER=lexical    # lexical (offline) | openai
EMBEDDING_MODEL=text-embedding-3-small

# Experiments
DEFAULT_CONCURRENCY=8
MAX_CONCURRENCY=64

# Production monitoring: metrics applied to ingested traces (JSON list)
MONITORING_METRICS=["answer_relevancy","faithfulness","toxicity","pii_leakage","prompt_injection","latency_ms","cost_usd"]
MONITORING_WORKERS=2

# Tracing (OpenTelemetry). Spans are always stored in the platform DB as well.
OTEL_ENABLED=true
OTEL_SERVICE_NAME=llm-eval-platform
OTEL_EXPORTER=none            # none | console | otlp
OTEL_EXPORTER_OTLP_ENDPOINT=  # e.g. http://localhost:4318
# Langfuse export (enabled when both keys are set)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Pricing overrides (YAML/JSON: model -> {input, output} USD per 1M tokens)
PRICING_FILE=

# Serve the built dashboard (frontend/dist) from the API in local mode
SERVE_FRONTEND=true

# Docker compose host ports
API_PORT=8000
WEB_PORT=8080
POSTGRES_PORT=5432
SEED_ON_START=true
